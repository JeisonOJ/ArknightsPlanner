{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/app.js": {
      "includeFiles": "server/app.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/app"
    }
  ]
}
